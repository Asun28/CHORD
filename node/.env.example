# Coordinator gate (src/server/session.ts). Set values in .dev.vars or .env for local runs; never commit them.
HUB_COORDINATOR_CODE=
SESSION_SECRET=
# Any non-empty value counts unlock failures per CF-Connecting-IP. Set it only behind the Cloudflare edge,
# which overwrites that header; leave it empty on the hall laptop, where a caller can set it.
TRUST_CF_CONNECTING_IP=
